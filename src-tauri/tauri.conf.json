{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RootUp",
  "version": "0.1.0",
  "identifier": "com.rootup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RootUp",
        "width": 1024,
        "height": 680,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["../resources/icons/RootUp_64x64.ico"]
  }
}

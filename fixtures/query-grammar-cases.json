    { "input": "kind:SOFTWARE kind:file", "kinds": ["software", "file"] },
    {
      "input": "kind:planet",
      "kinds": [],
      "words": ["kind:planet"]
    },
    { "input": "label:a tag:b", "labels": ["a", "b"] },
    { "input": "state:pending", "states": ["pending"] },
    {
      "input": "高数 type:pdf cat:document",
      "words": ["高数"],
      "types": ["pdf"],
      "categories": ["document"]
    },
    { "input": "size:>10MB", "sizeMin": 10485760 },
    { "input": "author:x", "words": ["author:x"] }
  ]
